{
  "sourceLanguage": "ja",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um die Wettervorhersage für deinen Standort abzurufen. Dein Standort verlässt das Gerät nicht, außer als Koordinaten an Apple Weather."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to get the weather forecast for where you are. Your location never leaves the device, except as coordinates sent to Apple Weather."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の気象予報を取得するために使います。位置情報は端末の外へ送られません（Apple Weather への座標送信のみ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치의 기상 예보를 받아오기 위해 사용해요. 위치 정보는 기기 밖으로 나가지 않아요(Apple Weather에 좌표를 보낼 때만 사용)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于获取当前位置的天气预报。位置信息不会离开设备（仅向 Apple Weather 发送坐标）。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um Anzeigen zu zeigen, die für dich relevanter sind. Deine Einträge und dein Standort werden nie für Werbung genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show ads that are more relevant to you. Your check-ins and location are never used for ads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する広告を、あなたに関係のあるものにするために使います。体調の記録や位置情報は広告に使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 관련성 높은 광고를 보여주기 위해 사용해요. 컨디션 기록과 위치 정보는 광고에 쓰지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于展示与你更相关的广告。你的记录和位置信息绝不会用于广告。"
          }
        }
      }
    }
  },
  "version": "1.0"
}