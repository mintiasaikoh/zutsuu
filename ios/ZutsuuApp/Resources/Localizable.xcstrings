          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is not allowed. Please enable it in the Settings app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보 사용이 허용되지 않았어요. 설정 앱에서 허용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许使用位置信息。请在“设置”应用中允许。"
          }
        }
      }
    },
    "位置情報は端末の外へ送られません。Apple Weather への座標送信だけに使います。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort verlässt das Gerät nicht, außer als Koordinaten an Apple Weather."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location never leaves the device, except as coordinates sent to Apple Weather."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보는 기기 밖으로 나가지 않아요. Apple Weather에 좌표를 보낼 때만 사용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置信息不会离开设备，仅用于向 Apple Weather 发送坐标。"
          }
        }
      }
    },
    "位置情報を許可する": {
      "localizations": {
        "de": {
