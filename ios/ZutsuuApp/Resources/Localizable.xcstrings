  "strings": {
    "%@ に通知": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigung um %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifies at %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通知"
          }
        }
      }
    },
    "%@、選択中": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ausgewählt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, selected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 선택됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已选择"
          }
        }
      }
    },
    "%@。あと%lld日の記録で選べます": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Wird nach %lld weiteren Tagen mit Einträgen freigeschaltet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Unlocks after %lld more days of check-ins"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. %lld일 더 기록하면 선택할 수 있어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。再记录 %lld 天即可选择"
          }
        }
      }
    },
    "%@の記録 %lld 件のうち、つらいが %lld 件（%lld%%）。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %lld Einträgen %@ waren %lld „schwer“ (%lld%%)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of %lld check-ins %@, %lld were “rough” (%lld%%)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기록 %lld건 중 “힘들어”가 %lld건(%lld%%)이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 %lld 条记录中，“难受”有 %lld 条（%lld%%）。"
          }
        }
      }
    },
    "%@の記録はまだありません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einträge %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No check-ins %@ yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기록이 아직 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有%@的记录。"
          }
        }
      }
    },
    "%lld / 18 pt": {
      "shouldTranslate": false
    },
    "%lld hPa": {
      "shouldTranslate": false
    },
    "3時間で%lldhPa上昇": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hPa Anstieg in 3 h"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up %lld hPa in 3 h"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3시간 동안 %lldhPa 상승"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3小时内上升 %lld hPa"
          }
        }
      }
    },
    "3時間で%lldhPa低下": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hPa Abfall in 3 h"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down %lld hPa in 3 h"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3시간 동안 %lldhPa 하강"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3小时内下降 %lld hPa"
          }
        }
      }
    },
    "6 時間前からの気圧低下が頭痛の発生をもっとも強く説明し、気圧そのものの高低より変化のほうが効くことが、4 万人規模の記録で示されています。6 時間の窓を置いているのはこのためです。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnungen von rund 40.000 Personen zeigen, dass ein Druckabfall über die vorangegangenen 6 Stunden das Auftreten von Kopfschmerzen am stärksten erklärt und die Änderung wichtiger ist als der Druck selbst. Deshalb verwenden wir ein 6-Stunden-Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records from about 40,000 people show that a pressure drop over the previous 6 hours explains headache onset most strongly, and that change matters more than the pressure level itself. That is why we use a 6-hour window."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 4만 명의 기록에서, 6시간 전부터의 기압 하강이 두통 발생을 가장 강하게 설명하고 기압의 높낮이보다 변화가 더 영향을 준다는 것이 나타났습니다. 6시간 창을 두는 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 4 万人的记录显示，过去 6 小时的气压下降最能解释头痛的发生，且气压的变化比气压本身的高低更重要。这就是采用 6 小时窗口的原因。"
          }
        }
      }
    },
    "72 時間以内に通知の予定はありません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 72 Stunden sind keine Benachrichtigungen geplant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notifications planned in the next 72 hours."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 72시간 안에 예정된 알림이 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来 72 小时内没有计划的通知。"
          }
        }
      }
    },
