    "%@。対策するなら今のうちに。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Jetzt ist der Moment, vorzusorgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Now is the time to prepare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 대비한다면 지금이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。要准备的话趁现在。"
          }
        }
      }
    },
    "%lld時間で%lldhPa上昇": {
      "localizations": {
