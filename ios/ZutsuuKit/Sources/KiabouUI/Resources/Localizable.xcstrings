          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平常"
          }
        }
      }
    },
    "いまの調子は%@。記録する": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade fühle ich mich %@. Eintragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling %@ right now. Record it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 컨디션은 %@. 기록하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在感觉%@。记录"
          }
        }
      }
    },
