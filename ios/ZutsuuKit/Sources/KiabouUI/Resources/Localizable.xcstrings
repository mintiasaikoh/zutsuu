    "きあぼうが毛布にくるまって休みます。記録はしません": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiabou kuschelt sich in eine Decke und ruht. Es wird nichts eingetragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiabou wraps up in a blanket and rests. Nothing is recorded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키아보가 담요를 덮고 쉬어요. 기록은 하지 않아요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气压鱼裹上毛毯休息。不会记录"
          }
        }
      }
    },
    "きあぼうと寝る": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Kiabou ausruhen"
