{
  "sourceLanguage": "ja",
  "strings": {
    "iPhone で予報を開くと、ここに今のリスクが出ます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Vorhersage auf dem iPhone, um hier dein aktuelles Risiko zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the forecast on iPhone to see your current risk here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 예보를 열면 여기에 지금의 위험도가 나와요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开预报后，这里会显示当前风险。"
          }
        }
      }
    },
    "「%@」を iPhone に送ったよ。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ an dein iPhone gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent “%@” to your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) iPhone으로 보냈어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已把“%@”发送到 iPhone。"
          }
        }
      }
    },
    "いま": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在"
          }
        }
      }
    },
    "いまの調子は%@。記録する": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade fühle ich mich %@. Eintragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling %@ right now. Record it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 컨디션은 %@. 기록하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在感觉%@。记录"
          }
        }
      }
    },
    "いまの調子は？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie geht es dir?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are you feeling?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 컨디션은?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在感觉如何？"
          }
        }
      }
    }
  },
  "version": "1.0"
}